# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stronghold
DB_USER=stronghold
DB_PASSWORD=stronghold_dev_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
LOG_LEVEL=info

# LLM Configuration
# Options: "claude", "huggingface_local", "huggingface_api"
LLM_PROVIDER=huggingface_local
LLM_MODEL=mistral-7b-instruct

# Claude API (if using Claude provider)
CLAUDE_API_KEY=your_claude_api_key_here

# Hugging Face API (if using Hugging Face API)
HUGGINGFACE_API_KEY=your_hf_api_key_here

# Vector DB Configuration (optional)
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_ENVIRONMENT=us-west2-az1
PINECONE_INDEX=stronghold-memories

# Security
SECRET_KEY=your_secret_key_change_in_production

# Simulation
SIMULATION_TICK_INTERVAL=3600  # seconds
WORLD_GENERATION_TIMEOUT=300  # seconds
MAX_CONCURRENT_WORLDS=10
