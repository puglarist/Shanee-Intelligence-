# Environment Configuration - Portable Omniverse Engine

# Environment
NODE_ENV=development
PORT=3000
HEALTH_CHECK_PORT=8080

# Database
DATABASE_URL=/workspace/data/omniverse.db

# External Drives
EXTERNAL_DRIVE_PATH=/media/external
EXTERNAL_DRIVE_ENABLED=true

# Logging
LOG_LEVEL=info

# Bluetooth Configuration
BLUETOOTH_DEVICE_NAME=Omniverse-Engine
BLUETOOTH_SERVICE_UUID=OmniverseService
BLUETOOTH_COMMAND_CHAR=OmniverseCommand
BLUETOOTH_STATE_CHAR=OmniverseState

# Simulation
SIMULATION_EARTH_ENABLED=true
SIMULATION_SPACE_ENABLED=true
SIMULATION_PHYSICS_ENABLED=true
SIMULATION_TERRAIN_RESOLUTION=256

# Asset Configuration
ASSET_MAX_FILE_SIZE=1073741824
ASSET_CHUNK_SIZE=5242880
ASSET_CACHE_TTL=604800

# Offline Configuration
OFFLINE_QUEUE_MAX_SIZE=1000
OFFLINE_QUEUE_EXPIRATION=2592000
OFFLINE_SYNC_INTERVAL=30000

# Debug
DEBUG=omniverse:*
