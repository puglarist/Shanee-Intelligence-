{
  "name": "omniverse-engine-backend",
  "version": "1.0.0",
  "description": "Portable Omniverse Engine - Backend Service",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development DEBUG=omniverse:* node server.js",
    "sim": "NODE_ENV=development DEBUG=omniverse:simulator node sim-server.js",
    "test": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "node db/migrate.js",
    "health-check": "node ../scripts/health-check.js"
  },
  "keywords": [
    "omniverse",
    "simulation",
    "engine",
    "portability"
  ],
  "author": "Shanee Intelligence",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "better-sqlite3": "^9.2.2",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1",
    "debug": "^4.3.4",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "three": "^r159",
    "cannon-es": "^0.20.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
